{
  "name": "fifa26-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FIFA26 预测系统 · 后端 API (Fastify + Drizzle/SQLite + pi AI)",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/ingest/seed.ts",
    "sync": "tsx src/ingest/sync.ts",
    "h2h": "tsx src/ingest/h2h.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.78.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "better-sqlite3": "^11.7.0",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild", "protobufjs"]
  }
}
