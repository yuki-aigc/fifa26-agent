# ── Server ───────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0

# ── Database ─────────────────────────────────────────────
# SQLite file path (relative to server/)
DATABASE_URL=./data/fifa26.sqlite

# ── AI (pi) ──────────────────────────────────────────────
# Provider-agnostic: pick "anthropic" or "openai" (any pi-ai KnownProvider works).
AI_PROVIDER=anthropic
# A model id known to pi-ai for that provider, e.g.:
#   anthropic -> claude-sonnet-4-5   |   openai -> gpt-4o
AI_MODEL=claude-sonnet-4-5
# Supply the key for whichever provider you selected (pi-ai reads these env vars).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: override the API endpoint (custom/self-hosted/proxy or OpenAI-compatible gateway).
# Leave empty to use the provider's default endpoint.
AI_BASE_URL=
# Optional: explicit API key that overrides the provider env var above.
# Required when AI_BASE_URL points to a gateway that doesn't match the provider's standard key.
AI_API_KEY=
# Optional: wire protocol used ONLY when AI_MODEL is not in pi-ai's built-in catalog
# (e.g. reaching Qwen / DeepSeek through an OpenAI-compatible gateway). Defaults to
# "openai-completions" (chat completions), which most gateways support.
# Example for Alibaba DashScope (Qwen):
#   AI_PROVIDER=openai
#   AI_MODEL=qwen-max            # use a model id your gateway accepts (e.g. qwen-max / qwen-plus)
#   AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   AI_API_KEY=sk-...
AI_API=openai-completions

# ── Live data (optional) ─────────────────────────────────
# Free API-Football key (https://www.api-football.com/) — drives `pnpm sync`
# (比分/状态/elapsed + 比赛统计 match_stats + 1X2 赔率) and the in-process scheduler.
# Seeding works fully WITHOUT this key.
API_FOOTBALL_KEY=
# FIFA World Cup league id / season in API-Football (verify in their dashboard).
API_FOOTBALL_LEAGUE_ID=1
API_FOOTBALL_SEASON=2026

# ── FiroAPI (optional, Chinese lottery market data) ─────────
# Used by `pnpm sync:firo` for pre-match HAD odds fallback when API-Football
# quota is unavailable. Private key must be PKCS#8 DER base64.
FIRO_API_KEY=
FIRO_PRIVATE_KEY=
# Firo scheduler is independent from API-Football. Keep the rolling window short
# during match days; use `pnpm sync:firo -- --days=N` manually for backfills.
FIRO_SYNC_ENABLED=false
FIRO_SYNC_INTERVAL_MIN=30
FIRO_SYNC_DAYS=2
# Detail pages reuse stored odds inside this TTL unless `refresh=1` is requested.
FIRO_DETAIL_TTL_MIN=10

# ── Observability ────────────────────────────────────────
LOG_LEVEL=info
# Optional: future Feishu alert webhook. Current implementation records logs/metrics first.
FEISHU_WEBHOOK_URL=
ALERT_FIRO_ERROR_RATE=0.3
ALERT_AI_DURATION_MS=12000

# ── In-process scheduler (赛事期间持续拉实时数据) ──────────
# 开启后, server 启动时按 interval 自动调 runSync (需 API_FOOTBALL_KEY)。
SYNC_ENABLED=false
SYNC_INTERVAL_MIN=5
# live = 仅拉进行中的比赛 (省 API 额度, 适合比赛日) | full = 拉全季
SYNC_MODE=live
# 是否随同步拉取比赛统计 (match_stats) 与赔率 (odds)
SYNC_STATS=true
SYNC_ODDS=true
