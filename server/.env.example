# ── Server ───────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0

# ── Database ─────────────────────────────────────────────
# SQLite file path (relative to server/)
DATABASE_URL=./data/wc2026.sqlite

# ── AI (pi) ──────────────────────────────────────────────
# Provider-agnostic: pick "anthropic" or "openai" (any pi-ai KnownProvider works).
AI_PROVIDER=anthropic
# A model id known to pi-ai for that provider, e.g.:
#   anthropic -> claude-sonnet-4-5   |   openai -> gpt-4o
AI_MODEL=claude-sonnet-4-5
# Supply the key for whichever provider you selected (pi-ai reads these env vars).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: override the API endpoint (custom/self-hosted/proxy or OpenAI-compatible gateway).
# Leave empty to use the provider's default endpoint.
AI_BASE_URL=
# Optional: explicit API key that overrides the provider env var above.
# Required when AI_BASE_URL points to a gateway that doesn't match the provider's standard key.
AI_API_KEY=
# Optional: wire protocol used ONLY when AI_MODEL is not in pi-ai's built-in catalog
# (e.g. reaching Qwen / DeepSeek through an OpenAI-compatible gateway). Defaults to
# "openai-completions" (chat completions), which most gateways support.
# Example for Alibaba DashScope (Qwen):
#   AI_PROVIDER=openai
#   AI_MODEL=qwen-max            # use a model id your gateway accepts (e.g. qwen-max / qwen-plus)
#   AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   AI_API_KEY=sk-...
AI_API=openai-completions

# ── Live data (optional) ─────────────────────────────────
# Free API-Football key (https://www.api-football.com/) used only by `pnpm sync`.
# Seeding works fully WITHOUT this key.
API_FOOTBALL_KEY=
# FIFA World Cup league id / season in API-Football (verify in their dashboard).
API_FOOTBALL_LEAGUE_ID=1
API_FOOTBALL_SEASON=2026
